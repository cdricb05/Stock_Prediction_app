{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 8A Experiment Registry Record",
  "description": "One row per pre-registered deterministic experiment. Pre-registration is mandatory: every experiment is recorded before its verdict, so the multiple-testing exposure is auditable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "owning_agent", "family", "hypothesis", "score_key", "quantile", "status"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP[0-9]{2}$"},
    "owning_agent": {"type": "string", "enum": ["momentum-signal-agent", "reversal-signal-agent", "trend-breadth-signal-agent", "volatility-liquidity-agent"]},
    "family": {"type": "string", "enum": ["momentum", "reversal", "trend_breakout", "volatility_liquidity", "breadth_relative_strength"]},
    "hypothesis": {"type": "string"},
    "score_key": {"type": "string", "description": "deterministic signal building block used"},
    "quantile": {"type": "string", "enum": ["top_decile", "top_quintile"]},
    "gate": {"type": ["string", "null"], "description": "optional eligibility gate (e.g. liquidity, relative-strength, uptrend)"},
    "universe": {"type": "string", "default": "S&P 500 Current & Past (survivorship-aware)"},
    "date_range": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "active_delisted_inclusion": {"type": "string", "default": "active + delisted while PIT member"},
    "n_periods": {"type": "integer", "minimum": 0},
    "avg_names": {"type": "number"},
    "one_sided_turnover": {"type": ["number", "null"]},
    "net_return_10bps": {"type": ["number", "null"]},
    "net_return_25bps": {"type": ["number", "null"]},
    "net_return_50bps": {"type": ["number", "null"]},
    "net_sharpe_25bps": {"type": ["number", "null"]},
    "net_max_drawdown_25bps": {"type": ["number", "null"]},
    "spy_sharpe": {"type": ["number", "null"]},
    "ew_universe_sharpe": {"type": ["number", "null"]},
    "placebo_net_sharpe_25bps": {"type": ["number", "null"]},
    "leakage_check": {"type": "string", "enum": ["PASS_NO_LOOKAHEAD", "FAIL"]},
    "status": {"type": "string", "enum": ["APPROVED", "WEAK", "REJECTED", "NEEDS_FULL_PANEL"]},
    "reason": {"type": "string"}
  }
}
