  "panel_schema": [
    {
      "column": "as_of_date",
      "maps_from": "constant AS_OF",
      "dtype": "date",
      "note": "data-vintage snapshot the panel was reconstructed at; all fundamentals attached point-in-time (available_date <= rebalance_date, no lookahead)"
    },
    {
      "column": "rebalance_date",
      "maps_from": "ev.entry_date",
      "dtype": "date",
      "note": "per-observation scoring / entry date; the cross-section (month/quarter) axis for all IC and backtest computations"
    },
    {
      "column": "ticker",
      "maps_from": "ev.ticker",
      "dtype": "str",
      "note": "issuer symbol (Norgate survivorship-free universe)"
    },
    {
      "column": "sector",
      "maps_from": "ev.sector",
      "dtype": "str",
      "note": "GICS-style sector; 'Unknown' where owned metadata is unmapped"
    },
    {
      "column": "cohort",
      "maps_from": "ev.cohort",
      "dtype": "str",
      "note": "'old' (original ~299) vs 'new' (8-V expanded) scoreable cohort"
    },
    {
      "column": "is_new_cohort",
      "maps_from": "ev.cohort == 'new'",
      "dtype": "bool",
      "note": "boolean form of cohort"
    },
    {
      "column": "liquidity_proxy",
      "maps_from": "ev.liquidity_proxy",
      "dtype": "float",
      "note": "dollar-volume liquidity proxy"
    },
    {
      "column": "fcf_to_assets",
      "maps_from": "ev.fcf_to_assets",
      "dtype": "float",
      "note": "raw point-in-time fundamental level (un-oriented)"
    },
    {
      "column": "operating_accruals",
      "maps_from": "ev.operating_accruals",
      "dtype": "float",
      "note": "raw point-in-time fundamental level (un-oriented)"
    },
    {
      "column": "fcf_to_assets_raw",
      "maps_from": "within_month_z(o_fcf_to_assets)",
      "dtype": "float",
      "note": "within-month z of the ORIENTED (+1) non-sector-neutral fcf leg; additive building block of composite_raw"
    },
    {
      "column": "operating_accruals_raw",
      "maps_from": "within_month_z(o_operating_accruals)",
      "dtype": "float",
      "note": "within-month z of the ORIENTED (-1, Sloan-negated) non-sector-neutral accruals leg; additive building block of composite_raw"
    },
    {
      "column": "fcf_to_assets_sector_neutral_z",
      "maps_from": "within_month_z(o_fcf_to_assets__sn)",
      "dtype": "float",
      "note": "within-month z of the oriented + within-month x sector de-meaned fcf leg; additive building block of composite_sn"
    },
    {
      "column": "operating_accruals_sector_neutral_z",
      "maps_from": "within_month_z(o_operating_accruals__sn)",
      "dtype": "float",
      "note": "within-month z of the oriented + within-month x sector de-meaned accruals leg; additive building block of composite_sn"
    },
    {
      "column": "operating_accruals_oriented_sector_neutral_z",
      "maps_from": "within_month_z(o_operating_accruals__sn)",
      "dtype": "float",
      "note": "identical to operating_accruals_sector_neutral_z: the pipeline's sector-neutral accruals leg is oriented (-1) BEFORE the within-month x sector de-mean, so the oriented and sector-neutral z coincide by construction"
    },
    {
      "column": "composite_sn",
      "maps_from": "ev.comp_sn",
      "dtype": "float",
      "note": "sector-neutral equal-weight composite = fcf_to_assets_sector_neutral_z + operating_accruals_sector_neutral_z; the honest 10-D baseline for the sector-neutral book"
    },
    {
      "column": "composite_raw",
      "maps_from": "ev.comp_raw",
      "dtype": "float",
      "note": "raw equal-weight composite = fcf_to_assets_raw + operating_accruals_raw; DIAGNOSTIC only (not the champion for a sector-neutral book)"
    },
    {
      "column": "forward_63d_return",
      "maps_from": "ev.fwd_exc_63",
      "dtype": "float",
      "note": "forward 63-trading-day (quarterly) benchmark-excess return from rebalance_date"
    },
    {
      "column": "forward_63d_return_start_date",
      "maps_from": "ev.entry_date",
      "dtype": "date",
      "note": "== rebalance_date"
    },
    {
      "column": "forward_63d_return_end_date",
      "maps_from": "(not persisted upstream)",
      "dtype": "date",
      "note": "the exact calendar END date of the 63-trading-day window is not persisted by the 10-C/10-D builder (only the realized 63d excess return is); requires the per-ticker trading calendar and is not needed for reweighting / IC tests"
    },
    {
      "column": "has_forward_return",
      "maps_from": "ev.fwd_exc_63 notna",
      "dtype": "bool",
      "note": "whether a forward 63d return is present"
    },
    {
      "column": "source_phase",
      "maps_from": "constant",
      "dtype": "str",
      "note": "10-B(normalized legs) + 10-C(panel) + 10-D(composite)"
    },
    {
      "column": "data_quality_flag",
      "maps_from": "derived",
      "dtype": "str",
      "note": "OK | OK_UNKNOWN_SECTOR | MISSING_COMPOSITE | MISSING_FWD_RETURN"
    }
  ],
