 "permitted_numeric_fields": [
  "realized_vol_63d",
  "gross_profitability",
  "fcf_to_assets",
  "operating_accruals",
  "leverage_change",
  "net_share_issuance"
 ],
 "forbidden_target_fields": [
  "fwd_1m_return",
  "fwd_1m",
  "forward_1m",
  "forward_63d_return",
  "forward_return",
  "fwd_return",
  "target",
  "realized_return"
 ],
 "max_factor_staleness_months": 15,
 "global_min_month_coverage": 0.60,
 "global_min_cross_sectional_coverage": 0.60,
 "source_universe_min_coverage": 0.60,
 "survivorship": {
  "require_pit_membership": true,
  "min_delisted_representation_fraction": 0.20,
  "note": "a source-observed universe may advance beyond diagnostic-only only when removed/delisted names are meaningfully represented; a current-survivor-only subset is DIAGNOSTIC_ONLY and can never create shadow eligibility"
 },
 "sector_history": {
  "require_pit_safe_for_promotion": true,
  "treat_unknown_as_sector": false,
  "note": "current EODHD GICS is CURRENT_ONLY, never presented as historical PIT classification; the sector-concentration gate is unchanged and is applied only diagnostically until a PIT-safe classification exists"
 },
 "diagnostics": {
  "max_features": 4,
  "initial_features": [
   "gross_profitability",
   "fcf_to_assets",
   "operating_accruals",
   "realized_vol_63d"
  ]
 },
 "budgets": {
  "max_diagnostic_features": 4,
  "max_portfolio_integrations": 2,
  "max_robustness_candidates": 2,
  "max_retry_per_tool": 1
 },
 "integration": {
  "baseline_weight": 0.8,
  "feature_weight": 0.2
 },
 "costs": {
  "primary_cost_bps_per_side": 25.0,
  "sensitivity_cost_bps_per_side": [12.5, 50.0]
 },
 "portfolio": {
  "top_n": 25,
  "sector_treatment": "sector_cap",
  "exit_buffer_fraction": 0.0,
  "universe": "mhz_reconstruction",
  "min_adv_dollar": 10000000.0
 },
 "ic_screen": {
  "min_months": 36,
  "min_coverage_fraction": 0.6,
  "min_abs_rank_ic_t": 1.0,
  "material_ic_t_margin": 0.25,
  "near_duplicate_abs_corr": 0.95,
  "max_complementary_abs_baseline_corr": 0.5,
  "max_top_rank_sector_share": 0.5,
  "leakage_suspicion_abs_ic": 0.5,
  "min_universe": 10
 },
 "baseline": {
  "rank_ic_t": 0.7943535272584944,
  "note": "committed Phase 29C/30A baseline aggregate rank-IC t-stat used for material/complementary comparison; recomputed from the reproduced baseline at run time"
 },
 "random_seed": 30,
 "strict_mode": true,
 "safety": {
  "research_only": true,
  "no_operational_promotion": true,
  "may_register_challengers": false
 }
}
