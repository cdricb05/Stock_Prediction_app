    "value_column": "gross_profitability",
    "ticker_column": "ticker",
    "availability_date_column": "available_date",
    "frequency": "quarterly_asof",
    "orientation": null,
    "restatement_caveat": true,
    "usage": "primary"
   },
   {
    "source_id": "fcf_to_assets",
    "provider": "eodhd_fundamentals",
    "kind": "eodhd_normalized",
    "subdir": "eodhd_fcf_to_assets",
    "file": "fcf_to_assets.csv",
    "value_column": "fcf_to_assets",
    "ticker_column": "ticker",
    "availability_date_column": "available_date",
    "frequency": "quarterly_asof",
    "orientation": null,
