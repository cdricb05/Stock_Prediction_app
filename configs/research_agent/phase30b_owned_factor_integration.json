    "file": "operating_accruals.csv",
    "value_column": "operating_accruals",
    "ticker_column": "ticker",
    "availability_date_column": "available_date",
    "frequency": "quarterly_asof",
    "orientation": null,
    "restatement_caveat": true,
    "usage": "primary"
   },
   {
    "source_id": "leverage_change",
    "provider": "eodhd_fundamentals",
    "kind": "eodhd_normalized",
    "subdir": "eodhd_leverage_change",
    "file": "leverage_change.csv",
    "value_column": "leverage_change",
    "ticker_column": "ticker",
    "availability_date_column": "available_date",
