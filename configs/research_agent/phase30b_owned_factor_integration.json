{
 "schema_version": "30B.1",
 "name": "phase30b_owned_factor_integration",
 "objective": "Connect already-owned, point-in-time-safe numeric factors (the realized_vol_63d column the momentum loader discards, and the raw EODHD normalized fundamental factors) to the deterministic research-agent diagnostic path, then evaluate them HONESTLY under an explicit universe/survivorship/sector contract. Coverage is never redefined to make a factor pass: the global 0.60 coverage gate is unchanged, and a separate source-observed universe result carries its own survivorship provenance and cannot create shadow eligibility. The deterministic engine performs every calculation; no order, broker, automation, promotion, or operational-model change is possible.",
 "data": {
  "inherit_data_cutoff_from_source_campaign": true,
  "data_cutoff": "2026-06-30",
  "source_campaign_cutoff_note": "committed Phase 29C / Phase 30A source-campaign cutoff (max formation month 2026-05; 310 formation months)"
 },
 "sources": {
  "roots": {
   "repo": "REPO_ROOT",
   "data_root": "DATA_ROOT"
  },
  "momentum_panel": {"root": "data_root", "relpath": "phase25_multi_horizon_alpha/_inputs/momentum_monthly_panel.csv"},
  "eodhd_normalized_root": {"root": "repo", "relpath": "research/data/eodhd/normalized"},
  "sector_map": {"root": "repo", "relpath": "research/output/phase10f_owned_sector_mapping_repair/repaired_sector_mapping.csv"},
  "factors": [
   {
    "source_id": "realized_vol_63d",
    "provider": "norgate_derived_price",
    "kind": "momentum_panel_column",
    "value_column": "realized_vol_63d",
    "ticker_column": "ticker",
    "availability": "formation_month",
    "frequency": "monthly",
    "orientation": null,
    "restatement_caveat": false,
    "usage": "primary"
   },
   {
    "source_id": "gross_profitability",
    "provider": "eodhd_fundamentals",
    "kind": "eodhd_normalized",
    "subdir": "eodhd_gross_profitability",
